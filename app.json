{
  "expo": {
    "name": "Yep, Did It",
    "slug": "yep-did-it",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yepdidit",
    "userInterfaceStyle": "automatic",
    "platforms": [
      "android",
      "ios"
    ],
    "description": "Did I lock the door? Turn off the stove? Take my pill? Tap once when you do it and check anytime.",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.suryanshu.yepdidit"
    },
    "android": {
      "package": "com.suryanshu.yepdidit",
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "monochromeImage": "./assets/images/adaptive-monochrome.png",
        "backgroundColor": "#3F44C2"
      },
      "permissions": [],
      "blockedPermissions": [
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#F5F6FA",
          "dark": {
            "image": "./assets/images/splash-icon.png",
            "backgroundColor": "#0D0E14"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#4B54D1"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-5257189700605632~3466144199",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-font",
      "expo-status-bar"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "742af9fb-c5c1-4095-8900-62f69cd4d3d1"
      }
    },
    "owner": "suryanshuverma"
  }
}
